# =============================================================================
# ARIA — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you need.
# At minimum, set ONE LLM provider key + the auth variables.

# ── Auth (required for GUI) ─────────────────────────────────────────────
# Comma-separated list of emails allowed to log in
ARIA_ALLOWED_EMAILS=you@example.com

# Resend API key for sending OTP codes (https://resend.com/docs)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=ARIA <aria@yourdomain.com>

# Internal secret for BFF proxy (SvelteKit → FastAPI).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Leave empty for local dev (disables auth check on FastAPI side).
ARIA_INTERNAL_SECRET=

# ── LLM Providers (set at least one) ────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ── Channels (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
DISCORD_BOT_TOKEN=your-discord-bot-token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# ── Deploy (production only) ───────────────────────────────────────────
# Your domain for CORS and SvelteKit ORIGIN/CSRF
ARIA_ORIGIN=https://aria.yourdomain.com
ARIA_CORS_ORIGINS=https://aria.yourdomain.com

# ── Ollama (optional, defaults shown) ──────────────────────────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── Google OAuth (optional) ────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
